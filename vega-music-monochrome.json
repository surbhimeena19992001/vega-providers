{
  "name": "Vega Music — Monochrome Edition",
  "version": "1.0.1",
  "description": "Monochrome music player prototype with local audio import, search, playback controls, shuffle, favorites, and responsive layout.",
  "format": "html-embedded-in-json",
  "runtime_note": "JSON is data, not an executable app. Extract app.html into index.html to run it in a browser.",
  "entry_file": "index.html",
  "features": [
    "local audio import",
    "music playback controls",
    "search",
    "favorites",
    "shuffle",
    "responsive monochrome UI"
  ],
  "app": {
    "filename": "index.html",
    "mime_type": "text/html",
    "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"theme-color\" content=\"#080808\"><title>Vega Music</title>\n<style>\n:root{color-scheme:dark;--bg:#090909;--panel:#151515;--line:#303030;--text:#f5f5f5;--muted:#a0a0a0;--accent:#fff}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px system-ui,-apple-system,Segoe UI,sans-serif}\nmain{max-width:950px;margin:auto;padding:24px 18px 150px}.brand{display:flex;align-items:center;gap:12px;font-size:22px;font-weight:800;letter-spacing:-1px}.logo{width:40px;height:40px;border-radius:13px;background:#fff;color:#000;display:grid;place-items:center}\n.hero{margin:26px 0;padding:25px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(135deg,#252525,#101010)}.eyebrow{color:#aaa;font-size:11px;letter-spacing:2px;text-transform:uppercase}.hero h1{font-size:clamp(28px,6vw,44px);letter-spacing:-2px;margin:12px 0}.hero p{color:var(--muted);line-height:1.6}\n.controls,.tools{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.btn{border:1px solid var(--line);border-radius:12px;padding:11px 14px;background:#191919;color:#fff}.btn.primary{background:#fff;color:#000;font-weight:800}.btn:active{transform:scale(.98)}input[type=search],input[type=text]{background:#151515;border:1px solid var(--line);border-radius:12px;padding:12px;color:white;width:100%}.search{margin:18px 0}.section{display:flex;justify-content:space-between;align-items:center;margin:26px 0 12px}.section h2{font-size:17px;margin:0}.muted{color:var(--muted);font-size:12px}\n.track{display:grid;grid-template-columns:44px minmax(0,1fr) auto auto;gap:12px;align-items:center;padding:11px;border-radius:14px}.track:hover{background:#171717}.cover{width:44px;height:44px;border-radius:11px;background:linear-gradient(135deg,#555,#171717);display:grid;place-items:center;font-size:20px}.meta{min-width:0}.meta strong,.meta span{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta strong{font-size:13px}.meta span{font-size:11px;color:var(--muted);margin-top:4px}.iconbtn{border:0;background:transparent;color:#bbb;font-size:20px;padding:8px}.iconbtn.liked{color:white}.empty{padding:25px;text-align:center;border:1px dashed #333;border-radius:15px;color:#aaa;line-height:1.7}\n.player{position:fixed;bottom:0;left:0;right:0;background:#111111f2;backdrop-filter:blur(18px);border-top:1px solid var(--line);padding:12px max(14px,calc((100vw - 914px)/2));display:grid;grid-template-columns:1fr 1.4fr;gap:15px;align-items:center}.now{min-width:0}.now strong,.now span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.now strong{font-size:12px}.now span{font-size:11px;color:#aaa;margin-top:4px}.player-controls{display:grid;gap:7px}.player-buttons{display:flex;justify-content:center;align-items:center;gap:13px}.play{width:40px;height:40px;border-radius:50%;background:white;color:black;font-size:17px}.range{width:100%;accent-color:white}.file{display:none}\n@media(min-width:700px){main{padding-top:32px}.hero{padding:36px}.track{padding:12px}}@media(max-width:480px){.player{grid-template-columns:1fr;gap:8px}.player-controls{grid-row:2}.now{grid-row:1}.hero{padding:20px}.track{grid-template-columns:40px minmax(0,1fr) auto auto;gap:8px}}\n</style></head>\n<body><main>\n<div class=\"brand\"><div class=\"logo\">♫</div><div>VEGA MUSIC<div class=\"muted\">YOUR SOUND. YOUR SPACE.</div></div></div>\n<section class=\"hero\"><div class=\"eyebrow\">PERSONAL MUSIC PLAYER</div><h1>Less noise.<br>More music.</h1><p>A calm, monochrome home for your own music. Import audio files from your device to begin listening.</p><div class=\"controls\"><button class=\"btn primary\" id=\"importBtn\">＋ Import music</button><button class=\"btn\" id=\"shuffleBtn\">⇄ Shuffle</button></div></section>\n<input class=\"file\" id=\"files\" type=\"file\" accept=\"audio/*,.mp3,.m4a,.wav,.ogg,.flac\" multiple>\n<div class=\"tools\"><input id=\"search\" type=\"search\" placeholder=\"Search your music…\" aria-label=\"Search your music\"></div>\n<div class=\"section\"><h2>Your library</h2><span class=\"muted\" id=\"count\">0 tracks</span></div>\n<div id=\"list\"><div class=\"empty\">Your library is waiting.<br>Tap <b>Import music</b> and choose audio files from your device.</div></div>\n</main>\n<footer class=\"player\"><div class=\"now\"><strong id=\"nowTitle\">Choose a song</strong><span id=\"nowArtist\">Import music to get started</span></div><div class=\"player-controls\"><div class=\"player-buttons\"><button class=\"iconbtn\" id=\"prev\" aria-label=\"Previous\">|◀</button><button class=\"play\" id=\"play\" aria-label=\"Play\">▶</button><button class=\"iconbtn\" id=\"next\" aria-label=\"Next\">▶|</button><button class=\"iconbtn\" id=\"like\" aria-label=\"Like\">♡</button></div><input class=\"range\" id=\"seek\" type=\"range\" min=\"0\" max=\"1000\" value=\"0\" aria-label=\"Seek\"></div></footer>\n<audio id=\"audio\" preload=\"metadata\"></audio>\n<script>\n(()=>{const $=id=>document.getElementById(id);const audio=$('audio');let tracks=[],current=-1,shuffle=false,liked=new Set(),urls=[];const fmt=n=>{if(!Number.isFinite(n))return'0:00';return Math.floor(n/60)+':'+String(Math.floor(n%60)).padStart(2,'0')};function filtered(){let q=$('search').value.toLowerCase().trim();return tracks.map((t,i)=>({...t,index:i})).filter(t=>(t.name+' '+t.artist).toLowerCase().includes(q))}function render(){let list=filtered();$('count').textContent=tracks.length+' track'+(tracks.length===1?'':'s');$('list').innerHTML=list.length?list.map(t=>'<div class=\"track\" data-index=\"'+t.index+'\"><div class=\"cover\">♫</div><div class=\"meta\"><strong>'+esc(t.name)+'</strong><span>'+esc(t.artist)+(t.index===current?' · NOW PLAYING':'')+'</span></div><button class=\"iconbtn '+(liked.has(t.index)?'liked':'')+'\" data-like=\"'+t.index+'\" aria-label=\"Toggle favorite\">'+(liked.has(t.index)?'♥':'♡')+'</button><button class=\"iconbtn\" data-play=\"'+t.index+'\" aria-label=\"Play '+esc(t.name)+'\">▶</button></div>').join(''):'<div class=\"empty\">'+(tracks.length?'No matching tracks.':'Your library is waiting. Import audio files to begin.')+'</div>'}function esc(s){return String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]))}function update(){let t=tracks[current];$('nowTitle').textContent=t?t.name:'Choose a song';$('nowArtist').textContent=t?t.artist:'Import music to get started';$('play').textContent=audio.paused?'▶':'Ⅱ';$('like').textContent=t&&liked.has(current)?'♥':'♡';$('like').classList.toggle('liked',!!t&&liked.has(current));if(audio.duration)$('seek').value=audio.currentTime/audio.duration*1000||0}function play(i){if(i<0||i>=tracks.length)return;current=i;audio.src=tracks[i].url;audio.play().catch(()=>{});render();update()}function advance(dir){if(!tracks.length)return;let i;if(shuffle&&tracks.length>1){i=current;while(i===current)i=Math.floor(Math.random()*tracks.length)}else i=(current+dir+tracks.length)%tracks.length;play(i)}$('importBtn').onclick=()=>$('files').click();$('files').onchange=e=>{for(const f of e.target.files){if(!f.type.startsWith('audio/')&&!/\\\\.(mp3|m4a|wav|ogg|flac|aac)$/i.test(f.name))continue;let url=URL.createObjectURL(f);urls.push(url);tracks.push({name:f.name.replace(/\\\\.[^.]+$/,''),artist:'Local audio',url})}render();if(current<0&&tracks.length)update();e.target.value=''};$('search').oninput=render;$('list').onclick=e=>{let like=e.target.closest('[data-like]'),playBtn=e.target.closest('[data-play]'),row=e.target.closest('[data-index]');if(like){let i=Number(like.dataset.like);liked.has(i)?liked.delete(i):liked.add(i);render();update()}else if(playBtn)play(Number(playBtn.dataset.play));else if(row)play(Number(row.dataset.index))};$('play').onclick=()=>{if(current<0){if(tracks.length)play(0);else $('files').click()}else if(audio.paused)audio.play().catch(()=>{});else audio.pause();update()};$('prev').onclick=()=>advance(-1);$('next').onclick=()=>advance(1);$('shuffleBtn').onclick=()=>{shuffle=!shuffle;$('shuffleBtn').textContent=shuffle?'⇄ Shuffle on':'⇄ Shuffle'};$('like').onclick=()=>{if(current>=0){liked.has(current)?liked.delete(current):liked.add(current);render();update()}};$('seek').oninput=e=>{if(audio.duration)audio.currentTime=Number(e.target.value)/1000*audio.duration};audio.ontimeupdate=()=>{if(audio.duration)$('seek').value=audio.currentTime/audio.duration*1000};audio.onended=()=>advance(1);audio.onplay=update;audio.onpause=update;window.addEventListener('pagehide',()=>urls.forEach(URL.revokeObjectURL));render()})();\n</script></body></html>"
  }
}